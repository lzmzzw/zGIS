{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zGIS",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 16 },
        "dragDropEnabled": true,
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": { "../scripts/mcp-headers-macos.sh": "mcp-headers-macos.sh" },
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
